{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moeuu.github.io/rotating-shield/contracts/hybrid-planning-recommendation-v1.schema.json",
  "title": "Non-actuating hybrid DSS-PP recommendation v1",
  "type": "object",
  "required": [
    "schema_version",
    "recommendation_id",
    "recommendation_kind",
    "algorithmic_recommendation_only",
    "robot_actuation_authorized",
    "selected_action",
    "sequence",
    "diagnostics",
    "belief",
    "candidate_attestation",
    "causal_boundary",
    "external_relocation",
    "pf_state_integrity",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "recommendation_id": {"$ref": "#/$defs/id"},
    "recommendation_kind": {"const": "algorithmic_dsspp_action_recommendation"},
    "algorithmic_recommendation_only": {"const": true},
    "robot_actuation_authorized": {"const": false},
    "selected_action": {
      "type": "object",
      "required": [
        "candidate_index",
        "dsspp_filtered_pose_index",
        "pose_xyz",
        "detector_height_m",
        "shield_program",
        "score"
      ],
      "properties": {
        "candidate_index": {"type": "integer", "minimum": 0},
        "dsspp_filtered_pose_index": {"type": "integer", "minimum": 0},
        "pose_xyz": {"$ref": "#/$defs/xyz"},
        "detector_height_m": {"type": "number"},
        "shield_program": {
          "type": "object",
          "required": ["name", "kind", "pair_ids"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "minLength": 1},
            "pair_ids": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 0, "maximum": 63}
            }
          },
          "additionalProperties": false
        },
        "score": {"type": "number"}
      },
      "additionalProperties": false
    },
    "sequence": {"type": "array"},
    "diagnostics": {"type": "object"},
    "belief": {
      "type": "object",
      "required": [
        "planner_belief_sources",
        "external_modes_included",
        "external_modes_quarantined_excluded",
        "included_external_mode_ids",
        "excluded_quarantined_mode_ids",
        "excluded_quarantined_mode_count",
        "external_strengths_and_weights_are_planner_metadata_only"
      ],
      "properties": {
        "planner_belief_sources": {"type": "array", "items": {"type": "string"}},
        "external_modes_included": {"type": "array", "items": {"type": "object"}},
        "external_modes_quarantined_excluded": {"type": "array", "items": {"type": "object"}},
        "included_external_mode_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "excluded_quarantined_mode_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "excluded_quarantined_mode_count": {"type": "integer", "minimum": 0},
        "external_strengths_and_weights_are_planner_metadata_only": {"const": true}
      },
      "additionalProperties": false
    },
    "candidate_attestation": {"type": "object"},
    "causal_boundary": {"type": "object"},
    "external_relocation": {"type": "object"},
    "pf_state_integrity": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "xyz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}]
    }
  }
}
