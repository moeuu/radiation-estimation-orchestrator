{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moeuu.github.io/rotating-shield/contracts/future-candidate-score-v1.schema.json",
  "title": "Frozen snapshot future-only candidate score v1",
  "type": "object",
  "required": [
    "schema_version",
    "score_family",
    "source_run_id",
    "snapshot_id",
    "snapshot_data_cutoff_step",
    "snapshot_data_cutoff_station",
    "future_step_ids",
    "future_station_ids",
    "isotope_names",
    "candidates",
    "hashes",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "score_family": {
      "const": "frozen_count_snapshot_cluster_log_predictive_ratio"
    },
    "source_run_id": {"$ref": "#/$defs/id"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "snapshot_data_cutoff_step": {"type": "integer", "minimum": 0},
    "snapshot_data_cutoff_station": {"type": "integer", "minimum": 0},
    "future_step_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "future_station_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "isotope_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "hashes": {
      "type": "object",
      "required": [
        "snapshot_file_sha256",
        "snapshot_canonical_sha256",
        "snapshot_mle_report_sha256",
        "snapshot_prefix_measurement_log_sha256",
        "current_measurement_log_sha256",
        "current_covered_records_sha256",
        "snapshot_covered_station_boundaries_sha256"
      ],
      "properties": {
        "snapshot_file_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_mle_report_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_prefix_measurement_log_sha256": {"$ref": "#/$defs/sha256"},
        "current_measurement_log_sha256": {"$ref": "#/$defs/sha256"},
        "current_covered_records_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_covered_station_boundaries_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "future_only",
        "snapshot_parameters_frozen",
        "no_refit",
        "truth_used"
      ],
      "properties": {
        "future_only": {"const": true},
        "snapshot_parameters_frozen": {"const": true},
        "no_refit": {"const": true},
        "truth_used": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step_score": {
      "type": "object",
      "required": [
        "step_id",
        "station_id",
        "log_predictive_likelihood_ratio"
      ],
      "properties": {
        "step_id": {"type": "integer", "minimum": 0},
        "station_id": {"type": "integer", "minimum": 0},
        "log_predictive_likelihood_ratio": {"type": "number"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "snapshot_candidate_id",
        "cluster_id",
        "isotope",
        "patch_ids",
        "future_step_scores",
        "cumulative_log_predictive_likelihood_ratio"
      ],
      "properties": {
        "snapshot_candidate_id": {"$ref": "#/$defs/id"},
        "cluster_id": {"type": "integer", "minimum": 0},
        "isotope": {"type": "string", "minLength": 1},
        "patch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "future_step_scores": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step_score"}
        },
        "cumulative_log_predictive_likelihood_ratio": {"type": "number"}
      },
      "additionalProperties": false
    }
  }
}
