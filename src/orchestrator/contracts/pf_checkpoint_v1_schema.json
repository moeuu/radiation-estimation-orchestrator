{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moeuu.github.io/rotating-shield/contracts/pf-checkpoint-v1.schema.json",
  "title": "Causal pure-PF checkpoint v1",
  "type": "object",
  "required": [
    "schema_version", "checkpoint_family", "checkpoint_id", "source_run_id",
    "measurement_log_schema_version", "data_cutoff_step", "data_cutoff_station",
    "covered_step_ids", "covered_records_sha256", "prefix_measurement_log_sha256",
    "pf_repository_commit", "resolved_config_sha256", "random_seed",
    "state_artifact", "state_artifact_sha256", "rng_state_sha256", "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint_family": {"const": "pure_pf_causal_state"},
    "checkpoint_id": {"$ref": "#/$defs/id"},
    "source_run_id": {"type": "string", "minLength": 1},
    "measurement_log_schema_version": {"const": 2},
    "data_cutoff_step": {"type": "integer", "minimum": 0},
    "data_cutoff_station": {"type": "integer", "minimum": 0},
    "covered_step_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "covered_records_sha256": {"$ref": "#/$defs/sha256"},
    "prefix_measurement_log_sha256": {"$ref": "#/$defs/sha256"},
    "pf_repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "resolved_config_sha256": {"$ref": "#/$defs/sha256"},
    "random_seed": {"type": "integer"},
    "state_artifact": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "state_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "rng_state_sha256": {"$ref": "#/$defs/sha256"},
    "safety": {
      "type": "object",
      "required": ["prefix_causal", "truth_read", "batch_feedback_applied"],
      "properties": {
        "prefix_causal": {"const": true},
        "truth_read": {"const": false},
        "batch_feedback_applied": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
