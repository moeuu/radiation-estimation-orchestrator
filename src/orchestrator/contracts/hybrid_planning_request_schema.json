{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moeuu.github.io/rotating-shield/contracts/hybrid-planning-request-v1.schema.json",
  "title": "Collision-attested hybrid DSS-PP planning request v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "source_run_id",
    "data_cutoff_step",
    "data_cutoff_station",
    "covered_records_sha256",
    "pf_resolved_config_sha256",
    "current_pose_xyz",
    "current_pair_id",
    "visited_poses_xyz",
    "candidate_poses_xyz",
    "candidate_attestation",
    "dsspp_config",
    "external_modes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/id"},
    "source_run_id": {"$ref": "#/$defs/id"},
    "data_cutoff_step": {"type": "integer", "minimum": 0},
    "data_cutoff_station": {"type": "integer", "minimum": 0},
    "covered_records_sha256": {"$ref": "#/$defs/sha256"},
    "pf_resolved_config_sha256": {"$ref": "#/$defs/sha256"},
    "current_pose_xyz": {"$ref": "#/$defs/xyz"},
    "current_pair_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 0, "maximum": 63}
      ]
    },
    "visited_poses_xyz": {
      "type": "array",
      "items": {"$ref": "#/$defs/xyz"}
    },
    "candidate_poses_xyz": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/xyz"}
    },
    "candidate_attestation": {
      "type": "object",
      "required": [
        "candidate_poses_sha256",
        "workspace_sha256",
        "planning_config_sha256",
        "collision_checked",
        "reachability_filtered"
      ],
      "properties": {
        "candidate_poses_sha256": {"$ref": "#/$defs/sha256"},
        "workspace_sha256": {"$ref": "#/$defs/sha256"},
        "planning_config_sha256": {"$ref": "#/$defs/sha256"},
        "collision_checked": {"const": true},
        "reachability_filtered": {"const": true}
      },
      "additionalProperties": false
    },
    "dsspp_config": {"type": "object"},
    "external_modes": {
      "type": "array",
      "items": {"$ref": "#/$defs/external_mode"}
    },
    "bounds_xyz": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/xyz"},
        "max": {"$ref": "#/$defs/xyz"}
      },
      "additionalProperties": false
    },
    "continuous_height_bounds_m": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{"type": "number"}, {"type": "number"}]
    },
    "allowed_pair_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 63}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "xyz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}]
    },
    "external_mode": {
      "type": "object",
      "required": [
        "mode_id",
        "isotope",
        "position_xyz",
        "strength_cps_1m",
        "weight",
        "spread_m",
        "verification_state",
        "source_snapshot_id"
      ],
      "properties": {
        "mode_id": {"$ref": "#/$defs/id"},
        "isotope": {"type": "string", "minLength": 1},
        "position_xyz": {"$ref": "#/$defs/xyz"},
        "strength_cps_1m": {"type": "number", "exclusiveMinimum": 0},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "spread_m": {"type": "number", "minimum": 0},
        "verification_state": {"enum": ["pending", "verified", "quarantined"]},
        "source_snapshot_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    }
  }
}
